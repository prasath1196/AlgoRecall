{
  "manifest_version": 3,
  "name": "AlgoRecall",
  "version": "2.0",
  "description": "Master LeetCode & coding problems with spaced repetition. Track progress, review solutions, and never forget what you've learned.",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "permissions": [
    "activeTab",
    "alarms",
    "identity",
    "notifications",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "*://*.leetcode.com/*",
    "*://*.hackerrank.com/*",
    "*://*.codeforces.com/*",
    "*://*.takeuforward.org/*",
    "*://takeuforward.org/*",
    "*://*.neetcode.io/*",
    "*://neetcode.io/*",
    "https://xqzgcvayyzuvbtlcgibe.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.leetcode.com/*",
        "*://*.hackerrank.com/*",
        "*://*.codeforces.com/*",
        "*://*.takeuforward.org/*",
        "*://takeuforward.org/*",
        "*://*.neetcode.io/*",
        "*://neetcode.io/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/dashboard/index.html",
        "injected.js",
        "assets/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost:5173/*"
    ]
  }
}
